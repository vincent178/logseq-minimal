{;; Only lint production namespaces as most dev
 ;; namespaces are unused
 :paths ["src/main" "src/electron" "src/test"]
 :api-namespaces [;; Ignore b/c too many false positives
                  frontend.db
                  ;; Used for debugging
                  frontend.db.debug
                  frontend.worker.debug
                  ;; Ignore because of dev work
                  helper
                  logseq.api
                  ;; Temporarily exempted while db_based/* handlers are being
                  ;; removed in layers (3b-3c-iv). These fns become unreferenced
                  ;; as their dead DB call-sites are peeled off, and the whole
                  ;; namespace is deleted at the end of the layer.
                  frontend.handler.db-based.property
                  frontend.handler.db-based.property.util
                  frontend.handler.db-based.page
                  ;; fsrs.cljs is a DB-only ns slated for full deletion (3c-iv-c);
                  ;; its call-sites were peeled off in 3d.
                  frontend.extensions.fsrs
                  ;; logseq.api.db-based is slated for full deletion (3e).
                  logseq.api.db-based]
 :report {:format :ignore}}
