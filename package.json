{
    "name": "LogseqOG",
    "version": "1.0.0",
    "private": true,
    "main": "static/electron.js",
    "engines": {
        "node": ">=22.20.0"
    },
    "devDependencies": {
        "@playwright/test": "=1.51.0",
        "@tailwindcss/aspect-ratio": "0.4.2",
        "@tailwindcss/forms": "0.5.3",
        "@tailwindcss/typography": "0.5.7",
        "autoprefixer": "^10.4.13",
        "cross-env": "^7.0.3",
        "cssnano": "^5.1.13",
        "glob": "9.0.0",
        "npm-run-all": "^4.1.5",
        "playwright": "=1.51.0",
        "postcss": "^8.4.47",
        "postcss-functions": "^4.0.2",
        "postcss-import": "15.0.0",
        "postcss-import-ext-glob": "2.0.1",
        "postcss-nested": "6.0.0",
        "process": "^0.11.10",
        "semver": "7.5.2",
        "shadow-cljs": "2.28.23",
        "stylelint": "^13.8.0",
        "stylelint-config-standard": "^20.0.0",
        "tailwindcss": "3.3.5",
        "tailwindcss-animate": "^1.0.7",
        "tinyglobby": "^0.2.17",
        "typescript": "^4.4.3",
        "vite": "^7",
        "vite-plugin-static-copy": "^3"
    },
    "scripts": {
        "watch": "run-p vite:assets-watch cljs:watch vite:worker-watch",
        "electron-watch": "run-p vite:assets-watch cljs:electron-watch vite:worker-watch",
        "app-watch": "run-p vite:assets-watch cljs:app-watch vite:worker-watch",
        "dev": "run-p vite:assets-watch cljs:dev-watch vite:worker-watch",
        "release": "run-s clean vite:assets-build cljs:release vite:worker-build",
        "release-app": "run-s clean vite:assets-build cljs:release-app vite:worker-build",
        "dev-release-app": "run-s clean vite:assets-build cljs:dev-release-app vite:worker-build",
        "dev-electron-app": "node scripts/electron-run.mjs",
        "release-electron": "run-s clean vite:assets-build vite:worker-build electron:make",
        "electron:make": "node scripts/electron-make.mjs",
        "debug-electron": "cd static/ && yarn electron:debug",
        "vite:assets-build": "vite build --config vite.assets.config.mjs",
        "vite:assets-watch": "cross-env NODE_ENV=development TAILWIND_MODE=watch vite build --watch --config vite.assets.config.mjs",
        "vite:worker-build": "vite build --config vite.worker.config.mjs",
        "vite:worker-watch": "node scripts/vite-worker-watch.mjs",
        "clean": "node scripts/clean-static.mjs",
        "test": "run-s cljs:test cljs:run-test",
        "smoke": "node scripts/smoke/core-features.mjs",
        "smoke:run": "scripts/smoke/run.sh",
        "verify": "scripts/smoke/verify.sh",
        "report": "run-s cljs:report",
        "style:lint": "stylelint \"src/**/*.css\"",
        "cljs:watch": "clojure -M:cljs watch app db-worker electron",
        "cljs:storybook-watch": "clojure -M:cljs watch stories-dev",
        "cljs:dev-watch": "clojure -M:cljs watch app db-worker electron",
        "cljs:app-watch": "clojure -M:cljs watch app db-worker",
        "cljs:electron-watch": "clojure -M:cljs watch app db-worker electron --config-merge \"{:asset-path \\\"./js\\\"}\"",
        "cljs:release": "clojure -M:cljs release app db-worker electron",
        "cljs:release-electron": "clojure -M:cljs release app db-worker electron --debug",
        "cljs:release-app": "clojure -M:cljs release app db-worker",
        "cljs:test": "clojure -M:test compile test",
        "cljs:run-test": "node static/tests.js",
        "cljs:dev-release-app": "clojure -M:cljs release app db-worker --config-merge \"{:closure-defines {frontend.config/DEV-RELEASE true}}\"",
        "cljs:dev-release-electron": "clojure -M:cljs release app db-worker electron --debug --config-merge \"{:closure-defines {frontend.config/DEV-RELEASE true}}\"",
        "cljs:debug": "clojure -M:cljs release app db-worker --debug",
        "cljs:report": "clojure -M:cljs run shadow.cljs.build-report app db-worker report.html",
        "cljs:build-electron": "clojure -A:cljs compile app db-worker electron",
        "cljs:lint": "clojure -M:clj-kondo --parallel --lint src --cache false",
        "ui:build": "yarn --cwd packages/ui install",
        "postinstall": "yarn ui:build"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.0.8",
        "@dnd-kit/sortable": "^7.0.2",
        "@emoji-mart/data": "^1.1.2",
        "@emoji-mart/react": "^1.1.1",
        "@glidejs/glide": "^3.6.0",
        "@highlightjs/cdn-assets": "10.4.1",
